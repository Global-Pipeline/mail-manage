APP_SECRET=replace-with-a-long-random-value
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
COOKIE_SECURE=1

MAIL_DATA_DIR=/opt/zhanyi-mail/data
EXTERNAL_URL=https://your-mail-host.example.com
SEND_INTERVAL_SECONDS=0.65

RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
WEBHOOK_TOKEN=replace-with-a-random-webhook-token

SILICONFLOW_API_KEY=sk-replace-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

FORWARD_SMTP_HOST=smtp.qq.com
FORWARD_SMTP_PORT=465
FORWARD_SMTP_USER=your-account@qq.com
FORWARD_SMTP_AUTH_CODE=replace-with-qq-smtp-authorization-code

TEST_EMAIL_RECIPIENT=recipient@example.com
