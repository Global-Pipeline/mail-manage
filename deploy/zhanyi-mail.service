[Unit]
Description=Zhanyi Mail Management System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhanyimail
Group=zhanyimail
WorkingDirectory=/opt/zhanyi-mail
EnvironmentFile=/opt/zhanyi-mail/.env
ExecStart=/opt/zhanyi-mail/venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:8125 app:app
Restart=always
RestartSec=3
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zhanyi-mail/data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
